# llm-wiki-pro2 environment variables — copy to .env and fill in

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI model via OpenRouter
AI_MODEL=deepseek/deepseek-v4-flash

# Server port
PORT=8000

# Base path when served behind nginx subpath ("" for local dev)
BASE_PATH=

# Data directory (sources + wiki + git repo). Defaults to <project>/data
# DATA_DIR=/path/to/llm-wiki-pro2/data

# Shared secret for the MCP endpoint (/mcp) — required as
# `Authorization: Bearer <MCP_API_KEY>`. Generate with: openssl rand -hex 32
# If unset, the MCP endpoint is disabled (503); the REST API is unaffected.
MCP_API_KEY=generate_a_random_secret_here

# Hosts/origins the MCP endpoint accepts (comma-separated, wildcards allowed).
# Defaults to localhost only — when serving behind a reverse proxy you MUST
# list the public host here or /mcp rejects requests with "Invalid Host header".
# MCP_ALLOWED_HOSTS=wiki.example.com,wiki.example.com:*,127.0.0.1:*,localhost:*
# MCP_ALLOWED_ORIGINS=https://wiki.example.com,http://127.0.0.1:*,http://localhost:*

# Opt-in shared secret for the REST API (/api/*) — required as
# `Authorization: Bearer <API_TOKEN>`. Generate with: openssl rand -hex 32
# The frontend page itself stays reachable (it prompts for the token and
# stores it in localStorage). If unset, the REST API stays fully open —
# same behavior as before this was added. Independent from MCP_API_KEY.
API_TOKEN=

# GitHub personal access token, used by app/github.py to read repos for
# the /api/github/sync connector (repo scope needed for private repos).
# The repo list itself lives in <DATA_DIR>/github-repos.json — copy
# github-repos.json.sample there and fill in your owner/repos.
GITHUB_TOKEN=

# Demo-mode kill switch — blocks ingest/query/lint/github-sync (the LLM-
# calling, credit-burning endpoints) with a 403 while GET endpoints (browse
# the existing wiki) keep working. Useful for a public, unauthenticated
# read-only demo instance. Off unless set to 1/true/yes.
# DEMO_DISABLE_LLM=
